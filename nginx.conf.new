worker_processes 1;

events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    keepalive_timeout 65;

    # 增大请求头缓冲区，避免 WAF 转发后头部过大导致 400
    client_header_buffer_size 32k;
    large_client_header_buffers 4 32k;

    server {
        listen 8082;
        server_name mufend.com www.mufend.com duokeer.com www.duokeer.com _;

        # 移动端检测 - 使用 set + if 替代 map（Windows Nginx 无 map 模块）
        set $device_root "C:/yuebao/packages/web/dist";
        if ($http_user_agent ~* "(mobile|android|iphone|ipod|ipad|windows phone|blackberry|webos|MicroMessenger)") {
            set $device_root "C:/yuebao/packages/mobile/dist";
        }

        root $device_root;
        index index.html;

        gzip on;
        gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
        gzip_min_length 1000;

        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;

        location /api/ {
            proxy_pass http://127.0.0.1:3000/api/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 300s;
            proxy_connect_timeout 75s;
        }

        # 上传文件代理 - 药品图片等静态资源
        location /uploads/ {
            proxy_pass http://127.0.0.1:3000/uploads/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            # 图片缓存7天
            expires 7d;
            add_header Cache-Control "public, max-age=604800";
        }

        location /auth/ {
            proxy_pass http://127.0.0.1:3000/api/auth/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /socket.io/ {
            proxy_pass http://127.0.0.1:3000/socket.io/;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }

        location /assets/ {
            root $device_root;
            expires -1;
            add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always;
            add_header Pragma "no-cache" always;
        }

        location = /logo.png {
            root $device_root;
            expires -1;
        }

        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}
